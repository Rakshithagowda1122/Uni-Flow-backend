# Local development connection (for running the API outside Docker).
# Browser-facing FastAPI URL; do not point this at the frontend port 3000.
VITE_API_BASE_URL=http://localhost:8000/api/v1
DATABASE_URL=postgresql+asyncpg://uniflow_app:change-this-app-password@localhost:5432/uniflow_db

# Generate a unique secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRET=replace-with-a-long-random-secret
TOKEN_EXPIRY_MINUTES=60
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Used by Docker Compose. Use URL-safe characters for the passwords.
POSTGRES_PASSWORD=change-this-db-password
APP_DB_PASSWORD=change-this-app-password
SEED_PASSWORD=change-this-seed-password
